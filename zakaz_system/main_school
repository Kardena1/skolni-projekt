        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Kritická chyba", f"Nelze načíst orders.json pro úpravy: {e}")
            return

        current_max_id = 0
        if all_orders_data:
            current_max_id = max([int(d.get("id", 0)) for d in all_orders_data.values()])

        new_json_data = {}
        
        try:
            for row in range(self.table1.rowCount()):
                item_id      = self.table1.item(row, 0)
                item_user_id = self.table1.item(row, 1)
                item_nazev   = self.table1.item(row, 2)
                item_pocet   = self.table1.item(row, 3)
