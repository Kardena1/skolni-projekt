    def handle_login(self):
        u = self.login_user.text().strip()
        passw = self.login_password.text()
        
        if not u or not passw:
            self.zobrazit_chybu("Prosím vyplňte uživatelské jméno i heslo.")
            return

        self.db_file = "users.json"
        found_user = None

        try:
            if not os.path.exists(self.db_file):
                self.check_db()

            with open(self.db_file, 'r', encoding='utf-8') as file:
                data = json.load(file)
            
            for user_data in data.values():
                if user_data.get("username") == u:
                    found_user = user_data
                    break
                    
            if found_user and found_user.get("password") == passw:
                self.user_role = found_user.get("role")
                self.user_id = found_user.get("id")
                self.final_username = u
                self.final_name = found_user.get("jmeno")
                self.accept()
            else:
                self.zobrazit_chybu("Neplatné přihlašovací údaje.")
        except json.JSONDecodeError:
            self.zobrazit_chybu("Databáze uživatelů je poškozená (chyba JSON).")
        except Exception as e:
            self.zobrazit_chybu(f"Chyba při přihlášení: {e}")

    def handle_register(self):
        u = self.reg_user_login.text().strip()
        p = self.reg_user_pass.text()
        p_ver = self.reg_user_ver.text()
        jmen = self.reg_user_name.text().strip()
        prijm = self.reg_user_surname.text().strip()
        telefon = self.reg_user_number.text().strip()
        firma = self.reg_user_firm.text().strip()
        self.db_file = "users.json"

        # Validace prázdných polí
        if not all([u, p, p_ver, jmen, prijm, telefon, firma]):
            self.zobrazit_chybu("Nezadali jste všechny údaje. Všechna pole jsou povinná.")
            return

        # --- NOVÉ: Kontrola formátu a délky telefonu a hesla ---
        telefon_cisla = telefon.replace(" ", "").replace("+", "")
        if len(telefon_cisla) < 9:
            self.zobrazit_chybu("Telefonní číslo je příliš krátké (min. 9 číslic).")
            return
            
        if len(p) < 6:
            self.zobrazit_chybu("Heslo musí mít alespoň 6 znaků.")
            return
        # -------------------------------------------------------

        if p != p_ver:
            self.zobrazit_chybu("Hesla se neshodují.")
            return


        try:
            if not os.path.exists(self.db_file):
                self.check_db()

            with open(self.db_file, 'r', encoding="utf-8") as file:
                data = json.load(file)

            # Kontrola existujícího uživatele
            for polozka in data.values():
                if polozka.get("username") == u:
                    self.zobrazit_chybu("Uživatelské jméno již existuje.")
                    return

            # Získání nového ID
            new_id = 1
            if data:
                new_id = max(uzivatel.get("id", 0) for uzivatel in data.values()) + 1

            data[f"user_{new_id}"] = {
                "id": new_id,
                "username": u,
                "jmeno": jmen,
                "prijmeni": prijm,
                "telefon": telefon,
                "firma": firma,
                "password": p,
                "role": "zakaznik"
            }

            with open(self.db_file, 'w', encoding="utf-8") as file:
                json.dump(data, file, indent=4, ensure_ascii=False)
                
            QMessageBox.information(self, "Hotovo", "Registrace byla úspěšná! Můžete se přihlásit.")
            self.auth_pages.setCurrentIndex(0)
            
        except json.JSONDecodeError:
            self.zobrazit_chybu("Chyba databáze (JSON). Nelze registrovat uživatele.")
        except Exception as e:
            self.zobrazit_chybu(f"Neočekávaná chyba při registraci: {e}")

    def zobrazit_chybu(self, text):
        msg = QMessageBox()
        msg.setIcon(QMessageBox.Warning)
        msg.setWindowTitle("Oznámení")
        msg.setText(text)
        msg.exec_()

    def make_password_visible(self, *inputs):
        if self.echomode == 0:
            for inp in inputs:
                inp.setEchoMode(QLineEdit.Normal)
            self.echomode = 1
        else:
            for inp in inputs:
                inp.setEchoMode(QLineEdit.Password)
            self.echomode = 0

    def check_db(self):
        self.db_file = "users.json"
        try:
            if not os.path.exists(self.db_file):
