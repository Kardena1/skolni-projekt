    def load_user_orders(self):
        try:
            with open("orders.json", "r", encoding="utf-8") as f:
                all_orders_data = json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            self.table.setRowCount(0)
            return
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Chyba", f"Nepodařilo se načíst soubor zakázek: {e}")
            return

        try:
            self.table.setRowCount(0)
            for key, data in all_orders_data.items():
                if str(data.get("user_id")) == str(self.current_id):
                    row = self.table.rowCount()
                    self.table.insertRow(row)
                    
                    self.table.setItem(row, 0, QTableWidgetItem(str(data.get("id", ""))))
                    self.table.setItem(row, 1, QTableWidgetItem(str(data.get("produkt", ""))))
                    self.table.setItem(row, 2, QTableWidgetItem(str(data.get("pocet", "0"))))
                    
                    desc_item = QTableWidgetItem(str(data.get("description", "")))
                    self.table.setItem(row, 3, desc_item)
                    
                    status_item = QTableWidgetItem(str(data.get("stav", "Nová")))
                    status_item.setFlags(status_item.flags() & ~QtCore.Qt.ItemIsEditable)
                    self.table.setItem(row, 4, status_item)
                    self.table.setItem(row, 5, QTableWidgetItem(str(data.get("datum", ""))))
        except Exception as e:
            print(f"Chyba načítání dat do tabulky zákazníka: {e}")

    def save_user_orders(self):
        try:
            with open("orders.json", "r", encoding="utf-8") as f:
                all_orders_data = json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            all_orders_data = {}
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Kritická chyba", f"Chyba při otevírání orders.json: {e}")
            return

        current_max_id = 0
        if all_orders_data:
            current_max_id = max([int(d.get("id", 0)) for d in all_orders_data.values()])

        keys_to_remove = [k for k, v in all_orders_data.items() if str(v.get("user_id")) == str(self.current_id)]
        for key in keys_to_remove:
            del all_orders_data[key]

        try:
            for row in range(self.table.rowCount()):
                id_item = self.table.item(row, 0)
                produkt_item = self.table.item(row, 1)
                pocet_item = self.table.item(row, 2)
                popis_item = self.table.item(row, 3)
                stav_item = self.table.item(row, 4)
                item_datum = self.table.item(row, 5)

                # Validace pole "Název" a "Počet"
                prod_text = produkt_item.text().strip() if produkt_item else ""
                if not prod_text:
                    QtWidgets.QMessageBox.warning(self, "Upozornění", f"Název zakázky (řádek {row+1}) nesmí být prázdný!")
                    # self.load_user_orders() # Vrátí tabulku do původního stavu
                    return

                ulozeny_cas = item_datum.text() if item_datum and item_datum.text() != "" else datetime.now().strftime("%d.%m.%Y %H:%M")
                
                raw_id = id_item.text() if id_item else ""
                
                if raw_id.isdigit():
                    this_id = int(raw_id)
                else:
                    current_max_id += 1
                    this_id = current_max_id
                
                key = f"order_{this_id}"
                all_orders_data[key] = {
                    "id": this_id,
                    "user_id": self.current_id,
                    "produkt": prod_text,
                    "pocet": pocet_item.text() if pocet_item else "0",
                    "description": popis_item.text() if popis_item else "",
                    "stav": stav_item.text() if stav_item else "Nová",
                    "datum": ulozeny_cas
                }
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Chyba", f"Chyba při formátování zakázek: {e}")
            return

        try:
            with open("orders.json", "w", encoding="utf-8") as f:
                json.dump(all_orders_data, f, indent=4, ensure_ascii=False)
            
            QtWidgets.QMessageBox.information(self, "Uloženo", "Vaše zakázky byly uloženy.")
            self.load_user_orders()
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Chyba při ukládání", f"Soubor se zakázkami se nepodařilo zapsat: {e}")

