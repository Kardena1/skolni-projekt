                raw_id = item_id.text() if item_id else ""
                if raw_id.isdigit():
                    this_id = int(raw_id)
                else:
                    current_max_id += 1
                    this_id = current_max_id

                datum_text = item_datum.text() if item_datum else ""
                if not datum_text or datum_text.strip() == "":
                    datum_text = datetime.now().strftime("%d.%m.%Y %H:%M")

