        grid_layout.addWidget(self.remove_order_button, 0, 3)

        self.order_layout.addLayout(grid_layout)
        self.pages.addWidget(page) 

    def create_profile_page(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.addWidget(QLabel("<h2>WORK IN PROGRESS</h2>"))
        self.pages.addWidget(page)

    def create_settings_page(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.addWidget(QLabel("<h2>Nastavení vzhledu</h2>"))
        
        self.combo_vzhled_cust = QComboBox()
        self.combo_vzhled_cust.addItems(["Normální", "Barvoslepý"])
        self.combo_vzhled_cust.setFixedWidth(200)
        self.combo_vzhled_cust.currentTextChanged.connect(aplikuj_vzhled)
        
        layout.addWidget(self.combo_vzhled_cust)
        layout.addStretch()
        self.pages.addWidget(page)

