            self, "Odhlášení", "Opravdu se chcete odhlásit?",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
        )
        if odpoved == QMessageBox.StandardButton.Yes:
            self.close()

    def handle_sidebar_click(self, item):
        text = item.text()
        if text == "Odhlásit":
            self.logout_action()

    def switch_page(self, index):
        if index < self.pages.count():
            self.pages.setCurrentIndex(index)

    def add_blank_user_row(self):
        try:
            max_id = 0
            for row in range(self.table.rowCount()):
                item = self.table.item(row, 0)
                if item and item.text().isdigit():
                    current_id = int(item.text())
                    if current_id > max_id:
                        max_id = current_id

            new_id = max_id + 1
            row_position = self.table.rowCount()
            self.table.insertRow(row_position)
            
            id_item = QTableWidgetItem(str(new_id))
            id_item.setFlags(id_item.flags() ^ QtCore.Qt.ItemIsEditable)
            self.table.setItem(row_position, 0, id_item)
            
            for i in range(1, 7):
                self.table.setItem(row_position, i, QTableWidgetItem(""))
                
            combo = QtWidgets.QComboBox()
            combo.addItems(["zakaznik", "admin"])
            self.table.setCellWidget(row_position, 7, combo)
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Chyba", f"Nepodařilo se přidat řádek uživatele: {e}")

    def delete_user(self):
        try:
            current_row = self.table.currentRow()
            if current_row < 0:
                QtWidgets.QMessageBox.warning(self, "Chyba", "Nejdříve vyberte uživatele, kterého chcete smazat.")
                return
                
            username_item = self.table.item(current_row, 1)
            username = username_item.text() if username_item else "Neznámý"

            odpoved = QtWidgets.QMessageBox.question(
                self, "Potvrdit smazání", f"Opravdu chcete smazat uživatele {username}?",
                QtWidgets.QMessageBox.StandardButton.Yes | QtWidgets.QMessageBox.StandardButton.No
            )
            if odpoved == QtWidgets.QMessageBox.StandardButton.Yes:
                self.table.removeRow(current_row)
                self.save_custommer_data()
        except Exception as e:
