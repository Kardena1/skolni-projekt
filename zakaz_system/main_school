    def load_custommer_data(self):
        try:
            if not os.path.exists(self.user_file):
                with open(self.user_file, 'w', encoding="utf-8") as f:
                    json.dump({}, f)

            with open(self.user_file, 'r', encoding="utf-8") as file:
                data = json.load(file)

            self.table.setRowCount(0)
            for polozka in data.values():
                row = self.table.rowCount()
                self.table.insertRow(row)

                combo = QtWidgets.QComboBox()
                combo.addItems(["zakaznik", "admin"])
                combo.setCurrentText(polozka.get("role", "zakaznik"))
                combo.currentIndexChanged.connect(lambda index, c=combo: self.oznamit_zmenu(index, c))
                
                id_item = QTableWidgetItem(str(polozka.get("id", "")))
                id_item.setFlags(id_item.flags() ^ QtCore.Qt.ItemIsEditable)

                self.table.setItem(row, 0, id_item)
                self.table.setItem(row, 1, QTableWidgetItem(str(polozka.get("username", ""))))
                self.table.setItem(row, 2, QTableWidgetItem(str(polozka.get("jmeno", ""))))
                self.table.setItem(row, 3, QTableWidgetItem(str(polozka.get("prijmeni", ""))))
                self.table.setItem(row, 4, QTableWidgetItem(str(polozka.get("telefon", ""))))
                self.table.setItem(row, 5, QTableWidgetItem(str(polozka.get("firma", ""))))
                self.table.setItem(row, 6, QTableWidgetItem(str(polozka.get("password", ""))))
                self.table.setCellWidget(row, 7, combo)
        except json.JSONDecodeError:
            QtWidgets.QMessageBox.critical(self, "Chyba", "Soubor s uživateli je poškozený.")
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Chyba", f"Nepodařilo se načíst uživatele: {e}")

    def save_custommer_data(self):
        new_data = {}
        try:
            for row in range(self.table.rowCount()):
                id_val = self.table.item(row, 0).text().strip() if self.table.item(row, 0) else ""
                username_val = self.table.item(row, 1).text().strip() if self.table.item(row, 1) else ""
                jmeno_val = self.table.item(row, 2).text().strip() if self.table.item(row, 2) else ""
                prijmeni_val = self.table.item(row, 3).text().strip() if self.table.item(row, 3) else ""
                telefon_val = self.table.item(row, 4).text().strip() if self.table.item(row, 4) else ""
                firma_val = self.table.item(row, 5).text().strip() if self.table.item(row, 5) else ""
                password_val = self.table.item(row, 6).text().strip() if self.table.item(row, 6) else ""
                
                combo = self.table.cellWidget(row, 7)
                vybrana_role = combo.currentText() if combo else "zakaznik"

                # Validace pole
                if not all([username_val, jmeno_val, prijmeni_val, password_val]):
                    QMessageBox.warning(self, "Upozornění", f"Na řádku {row + 1} chybí povinné údaje (Jméno, Příjmení, Username, Heslo). Úpravy se neuloží.")
                    return

                key = f"user_{id_val}"
                new_data[key] = {
                    "id": int(id_val) if id_val.isdigit() else 0,
                    "username": username_val,
                    "jmeno": jmeno_val,
                    "prijmeni": prijmeni_val,
                    "telefon": telefon_val,
                    "firma": firma_val,
                    "password": password_val,
                    "role": vybrana_role
                }
            
            with open(self.user_file, 'w', encoding="utf-8") as file:
                json.dump(new_data, file, indent=4, ensure_ascii=False)
            QMessageBox.information(self, "Uloženo", "Data uživatelů byla úspěšně uložena!")
        except Exception as e:
